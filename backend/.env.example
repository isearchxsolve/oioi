# Closed SaaS bootstrap. Set both values before the first production startup,
# then remove OIOI_OWNER_INITIAL_PASSWORD after you have signed in.
OIOI_CLOSED_SAAS_MODE=true
OIOI_OWNER_EMAIL=owner@example.com
OIOI_OWNER_INITIAL_PASSWORD=replace-with-a-unique-12-character-minimum-password
OIOI_AUTH_SESSION_TTL_HOURS=168

# Use PostgreSQL for every multi-user production deployment. SQLite is suitable
# only for local development and the single-process film job store.
DATABASE_URL=postgresql+asyncpg://oioi:replace-me@localhost:5432/oioi
APP_ENV=production
