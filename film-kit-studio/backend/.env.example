# ── Film Kit Studio — Backend Environment ──────────────────
# Copy to .env and fill in your values.

# NVIDIA NIM API key (get one free at https://build.nvidia.com → API Keys)
NIM_API_KEY=your_nvidia_nim_api_key_here

# LLM model for script/storyboard generation
NIM_LLM_MODEL=meta/llama-3.1-70b-instruct

# Cosmos3 NIM model for visual generation
NIM_COSMOS_MODEL=nvidia/cosmos-3-generator

# Rate limiting (requests per minute) — NIM free tier is ~40 RPM
NIM_RPM=40

# Database URL (SQLite by default; switch to postgresql:// for Postgres)
DATABASE_URL=sqlite+aiosqlite:///./film_kit_studio.db

# Server
HOST=0.0.0.0
PORT=8000

# CORS — allow the Next.js dev server
FRONTEND_URL=http://localhost:3000

# Projects storage directory
PROJECTS_DIR=./projects

# ── Provider selection (free defaults work with zero keys) ──
# Options: cosmos (free) | veo | kling
VISUAL_PROVIDER=cosmos
# Options: edge (free) | elevenlabs
VOICE_PROVIDER=edge
# Options: ffmpeg (free) | suno
MUSIC_PROVIDER=ffmpeg
# Options: nim (free) | openai | anthropic | gemini
SCRIPT_PROVIDER=nim

# ── Google Veo 3.1 (Gemini API) — cinematic visual tier ─────
# Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
VEO_MODEL=veo-3.1

# ── Kling 3.0 — cinematic visual tier ───────────────────────
# Get keys at https://klingai.com/developer
KLING_API_KEY=
KLING_API_SECRET=

# ── ElevenLabs — cinematic voice tier ───────────────────────
# Get a key at https://elevenlabs.io/app/settings/api-keys
ELEVENLABS_API_KEY=
ELEVENLABS_MODEL=eleven_v3

# ── Suno (via gateway) — real score tier ────────────────────
# Suno has no official API; use a gateway provider (e.g. musicapi.ai).
SUNO_API_KEY=
SUNO_BASE_URL=https://api.musicapi.ai

# ── Script LLM providers (NIM is free default) ──────────────
# OpenAI — GPT-4o etc. (https://platform.openai.com/api-keys)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o

# Anthropic — Claude 3.5 Sonnet etc. (https://console.anthropic.com/settings/keys)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

# Gemini — already uses GEMINI_API_KEY above
GEMINI_MODEL=gemini-1.5-pro

# ── Cinematography ──────────────────────────────────────────
# Global style prefix injected into every visual prompt.
CINEMATOGRAPHY_STYLE=cinematic, shot on anamorphic lenses, shallow depth of field, film grain, professional color grade, 24fps motion cadence

# ── Review / Trim defaults ──────────────────────────────────
# Default transition when stitching clips (cut | crossfade)
DEFAULT_TRANSITION_MODE=cut
# Default crossfade duration in seconds
DEFAULT_TRANSITION_DURATION=0.5
# Default trim start (seconds from clip start) — null = no trim
DEFAULT_TRIM_START=
# Default trim end (seconds from clip start) — null = no trim
DEFAULT_TRIM_END=

# ── Director Agent (M1) ──────────────────────────────────────
# Max critique/regeneration iterations
DIRECTOR_MAX_ITERATIONS=3
# Critic VLM provider (gemini | openai)
DIRECTOR_CRITIC_PROVIDER=gemini
# Planner LLM provider (anthropic | openai)
DIRECTOR_PLANNER_PROVIDER=anthropic
# Score threshold to pass (0-1)
DIRECTOR_CRITIC_THRESHOLD=0.75
# Pacing: beats per minute
DIRECTOR_BEATS_PER_MINUTE=1.5
# Target duration in seconds
DIRECTOR_TARGET_DURATION=60.0

# ── ControlNet / LoRA / Training (M2) ────────────────────────
# ControlNet model path (local)
CONTROLNET_MODEL_PATH=
# LoRA storage path
LORA_STORAGE_PATH=./loras
# kohya-ss path for local training
KOHYA_SS_PATH=./kohya-ss
# Base model for LoRA training
BASE_MODEL_PATH=stabilityai/stable-diffusion-xl-base-1.0

# ── Lip-sync (M2) ────────────────────────────────────────────
# LivePortrait ONNX model path
LIVEPORTRAIT_MODEL_PATH=

# ── Audio Post (M3) ──────────────────────────────────────────
# Demucs model for stem separation
DEMUCS_MODEL=htdemucs

# ── Color / LUT (M3) ─────────────────────────────────────────
# LUT library path
LUT_LIBRARY_PATH=./luts
# Colourlab AI API key (optional)
COLOURLAB_API_KEY=

# ── DaVinci Resolve Scripting (M3) ──────────────────────────
# Path to Resolve scripting module
RESOLVE_SCRIPT_PATH=